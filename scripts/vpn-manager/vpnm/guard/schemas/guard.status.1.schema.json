{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guard.status/1",
  "title": "guard.status/1",
  "description": "Daemon status snapshot for `vpn guard status --json`. Carries only contract hashes, counters and open incidents — no log text. Incidents are inlined in $defs so the file validates without a resolver; guard.incident.1.schema.json is the standalone contract and the test asserts both copies are identical.",
  "type": "object",
  "required": ["schema", "running", "since", "counters"],
  "properties": {
    "schema": {"const": "guard.status/1"},
    "running": {"type": "boolean"},
    "state": {"enum": ["armed", "idle"]},
    "pid": {"type": ["integer", "null"], "minimum": 1},
    "since": {"type": "string", "format": "date-time"},
    "unit_profile": {"enum": ["hardened", "compat", null]},
    "rules_hash": {"$ref": "#/$defs/hash"},
    "config_hash": {"$ref": "#/$defs/hash"},
    "sources_ref": {"type": "string", "maxLength": 128},
    "last_event_ts": {"type": ["string", "null"], "format": "date-time"},
    "last_lifecycle": {
      "type": ["object", "null"],
      "required": ["signal", "ts", "cause"],
      "properties": {
        "signal": {"type": "string", "maxLength": 32},
        "ts": {"type": "string", "format": "date-time"},
        "cause": {"enum": ["vpn_up", "vpn_down", "vpn_switch", "unknown"]}
      }
    },
    "counters": {
      "type": "object",
      "required": ["events", "unparsed", "dropped", "findings"],
      "properties": {
        "events": {"type": "integer", "minimum": 0},
        "unparsed": {"type": "integer", "minimum": 0},
        "dropped": {"type": "integer", "minimum": 0},
        "findings": {"type": "integer", "minimum": 0},
        "suppressed": {"type": "integer", "minimum": 0}
      }
    },
    "open_incidents": {
      "type": "array",
      "maxItems": 32,
      "items": {"$ref": "#/$defs/incident"}
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "incident": {
      "type": "object",
      "required": ["schema", "id", "headline", "root_cause", "first", "last", "findings"],
      "properties": {
        "schema": {"const": "guard.incident/1"},
        "id": {"type": "string", "pattern": "^i-[0-9a-f]{6}$"},
        "headline": {"type": "string", "maxLength": 240},
        "root_cause": {
          "enum": [
            "tunnel_down",
            "censorship_suspect",
            "config",
            "dns",
            "local_net",
            "local_fault",
            "endpoint_unreachable",
            "degraded",
            "observability"
          ]
        },
        "confidence": {"enum": ["low", "medium", "high"]},
        "first": {"type": "string", "format": "date-time"},
        "last": {"type": "string", "format": "date-time"},
        "resolved_at": {"type": ["string", "null"], "format": "date-time"},
        "unit": {"type": ["string", "null"]},
        "profile": {"type": ["string", "null"]},
        "findings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {"type": "string", "pattern": "^[0-9a-f]{12}$"},
          "description": "Finding ids (guard.finding/1.id)."
        },
        "server": {
          "type": ["object", "null"],
          "properties": {
            "threat_level": {"enum": ["quiet", "elevated", "high", null]},
            "stage": {"type": ["string", "null"]},
            "age_s": {"type": "integer", "minimum": 0},
            "fresh": {"type": "boolean"},
            "lockdown": {"type": "boolean"}
          },
          "required": ["threat_level", "fresh", "lockdown"]
        }
      }
    }
  }
}
