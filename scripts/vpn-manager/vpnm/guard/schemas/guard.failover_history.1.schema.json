{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guard.failover_history/1",
  "title": "guard.failover_history/1",
  "description": "One failover attempt/outcome line (SPEC-20261118-vpn-failover §9). Append-only JSONL, 0600, rotated like findings.jsonl; no secrets, prose is redacted.",
  "type": "object",
  "required": [
    "schema",
    "ts",
    "event"
  ],
  "properties": {
    "schema": {
      "const": "guard.failover_history/1"
    },
    "ts": {
      "type": "string",
      "maxLength": 40
    },
    "event": {
      "enum": [
        "attempt",
        "switch",
        "blackout",
        "lockdown_off",
        "suppressed",
        "queued",
        "queued_flushed",
        "teardown"
      ]
    },
    "from": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 64
    },
    "to": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 64
    },
    "result": {
      "enum": [
        "ok",
        "dead_entry",
        "dead_exit",
        "switch_error",
        null,
        "xsplit_stopped"
      ]
    },
    "trigger": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 40
    },
    "latency_ms": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "note": {
      "type": "string",
      "maxLength": 240
    },
    "attempts": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "candidate",
          "result"
        ],
        "properties": {
          "candidate": {
            "type": "string",
            "maxLength": 64
          },
          "result": {
            "enum": [
              "ok",
              "dead_entry",
              "dead_exit",
              "switch_error",
              "skipped"
            ]
          },
          "detail": {
            "type": "string",
            "maxLength": 120
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
